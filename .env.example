# Copy to .env (git-ignored). `npm start` reads it.

# Required: the single login password.
ROKHAN_PASSWORD=

# PORT=8787
# HOST=127.0.0.1
# ROKHAN_DATA_DIR=./data

# Set behind Tailscale Serve, e.g. https://host.tailnet.ts.net:8444
# Makes cookies Secure and requires this Origin on state-changing requests.
# ROKHAN_PUBLIC_ORIGIN=

# Web push (the daily lesson notification) needs a contact for the push service when
# ROKHAN_PUBLIC_ORIGIN is not an https address: a mailto: or https: address.
# Without either, the notification is reported as not configured.
# ROKHAN_PUSH_CONTACT=mailto:you@example.com

# ROKHAN_MODEL=claude-opus-5-5
# ROKHAN_EFFORT=high
# ROKHAN_TZ=Europe/Bucharest

# 1 = canned answers, no model (tests, UI work).
# ROKHAN_FAKE_LLM=1
