{
  "name": "rokhan-clinical-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rokhan: study and on-call assistant for an OB-GYN resident (replaces the Telegram bot)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "import": "node scripts/import-from-openclaw.mjs",
    "eval": "node --env-file-if-exists=.env scripts/eval.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "unpdf": "^2.2.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
